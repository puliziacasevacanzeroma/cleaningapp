# ================================================================
# CleaningApp — Variabili d'ambiente
# ================================================================
# Copia questo file in .env e compila tutti i valori.
# MAI committare il file .env su Git (è già in .gitignore).
# ================================================================


# ── Autenticazione JWT ──────────────────────────────────────────
# Segreto per firmare i token JWT di sessione.
# Genera con: openssl rand -base64 32
# Minimo 32 caratteri obbligatori.
AUTH_SECRET=""


# ── Firebase Client SDK (pubblico, incluso nel bundle JS) ───────
# Trovalo in: Firebase Console → Impostazioni progetto → Le tue app
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""   # opzionale (Google Analytics)

# ── Firebase Push Notifications (VAPID key) ──────────────────────
# Trovalo in: Firebase Console → Cloud Messaging → Web Push certificates
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""


# ── Firebase Admin SDK (SEGRETO — solo lato server) ─────────────
# Trovalo in: Firebase Console → Impostazioni progetto → Account di servizio
# → Genera nuova chiave privata → scarica il JSON e copia i campi qui.
# ATTENZIONE: non committare mai questo file con questi valori!
FIREBASE_ADMIN_PROJECT_ID=""
FIREBASE_ADMIN_CLIENT_EMAIL=""
# La private key è multilinea. Copia il valore dal JSON sostituendo
# i newline reali con \n (stringa letterale backslash-n).
FIREBASE_ADMIN_PRIVATE_KEY=""

# ── Firebase Storage Bucket (usato lato server per upload) ───────
# Di solito uguale a NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET
FIREBASE_STORAGE_BUCKET=""


# ── Cron Job Secret ─────────────────────────────────────────────
# Protezione per gli endpoint /api/cron/*.
# Genera con: openssl rand -base64 24
# DEVE essere impostato in produzione — nessun default di fallback.
CRON_SECRET=""


# ── Email (Resend) ───────────────────────────────────────────────
# Trovalo in: https://resend.com/api-keys
RESEND_API_KEY=""


# ── URL pubblica dell'app ────────────────────────────────────────
# Usata per generare link nelle email. Senza trailing slash.
# Es: https://app.tuodominio.it
NEXT_PUBLIC_APP_URL=""


# ── Upstash Redis (opzionale — per caching) ─────────────────────
# Trovalo in: https://console.upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
